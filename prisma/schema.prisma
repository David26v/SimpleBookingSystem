generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("BOOKING_DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  avatarUrl String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
  listings  Listing[]
}

model Booking {
  id         String   @id @default(cuid())
  checkIn    DateTime
  checkOut   DateTime
  guests     Int      @default(1)
  totalPrice Float
  status     String   @default("confirmed")
  listingId  String
  userId     String
  createdAt  DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([listingId, checkIn, checkOut])
}

model Listing {
  id            String    @id @default(cuid())
  title         String
  description   String
  imageUrl      String
  pricePerNight Float
  location      String
  maxGuests     Int       @default(4)
  hostId        String
  createdAt     DateTime  @default(now())
  bookings      Booking[]
  host          User      @relation(fields: [hostId], references: [id])
}
